REVIVE_COVERS_PER_DAY=20
REVIVE_AI_REQUESTS_PER_HOUR=10
REVIVE_AI_REQUESTS_PER_DAY=100
REVIVE_OWNER_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=revive-authorized-games
# Never ship storage credentials with a Windows installer or commit them to Git.

# REVIVE v0.7: Supabase Auth and persistent friends/messages; only publishable key on desktop.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# From Vercel Marketplace > Upstash for Redis; server-only variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
