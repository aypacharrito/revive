{
  "name": "revive-desktop",
  "version": "1.2.0",
  "private": true,
  "author": "REVIVE contributors",
  "description": "REVIVE game library with recent games, save protection, friends and persistent verified downloads",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.revive.arcade",
    "productName": "REVIVE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icons/revive.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "REVIVE-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "aypacharrito",
        "repo": "revive",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.10"
  }
}
