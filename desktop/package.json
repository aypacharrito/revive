{
  "name": "revive-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Private launcher for existing PC game installations and save backups",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.revive.arcade",
    "productName": "REVIVE",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "ui/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
